{
  "manifest_version": 3,
  "name": "Salesforce UI improvements",
  "version": "1.17",
  "permissions": ["activeTab"],
  "host_permissions": ["https://*.lightning.force.com/"],
  "content_scripts": [
    {
      "matches": ["https://*.lightning.force.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "kb.html",
        "templates.html"
      ],
      "matches": ["https://*.lightning.force.com/*"]
    }
  ]
}